# Copy to ".env" in the repo root (next to docker-compose.yml). Do not commit .env.
# Docker sets SPRING_PROFILES_ACTIVE=docker — you do not need application-local.properties.

# --- PostgreSQL (servicio db) ---
POSTGRES_DB=recetario_db
POSTGRES_USER=recetario_user
POSTGRES_PASSWORD=change_me_use_a_long_random_password

# --- Spring Boot (debe coincidir con Postgres) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/recetario_db
SPRING_DATASOURCE_USERNAME=recetario_user
SPRING_DATASOURCE_PASSWORD=change_me_use_a_long_random_password

# Medios (imágenes/vídeos) dentro del contenedor backend
APP_MEDIA_ROOT=/data/media

# JWT — mínimo 32 caracteres (genera uno aleatorio para producción)
APP_JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
APP_JWT_EXPIRATION_HOURS=168
APP_JWT_COOKIE_NAME=recetario_auth
# true solo si sirves la app por HTTPS
APP_JWT_COOKIE_SECURE=false

# CORS: patrones separados por coma. Añade la IP fija de tu VM cuando la tengas.
# Ejemplo VM: http://10.20.30.40:*,http://10.20.30.40
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*

# Puerto público del front (nginx)
WEB_PORT=80

# Build del front: vacío = mismo origen (nginx hace proxy de /api y /media)
VITE_API_URL=
