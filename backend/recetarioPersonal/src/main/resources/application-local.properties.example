# LOCAL DEVELOPMENT ONLY — not used by Docker.
# 1. Copy this file to application-local.properties (same directory).
# 2. Set your Postgres password below.
# 3. Run the backend with profile "local" (default in application.properties).

spring.datasource.url=jdbc:postgresql://localhost:5432/recetario_db
spring.datasource.username=recetario_user
spring.datasource.password=your_password_here

app.media.root=${user.home}/recetario-media
spring.jpa.show-sql=true
